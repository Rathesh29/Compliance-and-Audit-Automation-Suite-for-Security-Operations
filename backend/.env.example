# Compliance and Audit Automation Suite Backend Configuration

# Database Configuration (PostgreSQL primary with automatic SQLite fallback for local zero-setup dev)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/security_compliance
DATABASE_URL_SQLITE_FALLBACK=true
SQLITE_FALLBACK_URL=sqlite:///./security_compliance.db

# JWT & Authentication Security
JWT_SECRET_KEY=compliance_and_audit_super_secret_jwt_key_2026_operations_suite!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Notification Service Provider ('console', 'log', 'smtp')
NOTIFICATION_PROVIDER=console

# Background Missed-Shift Detection Worker Frequency (seconds)
MISSED_SHIFT_CHECK_INTERVAL_SECONDS=30
